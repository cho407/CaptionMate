    "The app only accesses audio/video files that you explicitly select through the file picker. We do not access any files without your direct action." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App greift nur auf Audio-/Videodateien zu, die du ausdrücklich über die Dateiauswahl auswählst. Ohne deine direkte Aktion greifen wir auf keine Dateien zu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app only accesses audio/video files that you explicitly select through the file picker. We do not access any files without your direct action."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app only accesses audio/video files that you explicitly select through the file picker. We do not access any files without your direct action."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يصل التطبيق إلا إلى ملفات الصوت/الفيديو التي تختارها صراحة عبر منتقي الملفات. لا نصل إلى أي ملفات دون إجراء مباشر منك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app solo accede a los archivos de audio o video que seleccionas explícitamente mediante el selector de archivos. No accedemos a ningún archivo sin tu acción directa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app accède uniquement aux fichiers audio/vidéo que vous sélectionnez explicitement via le sélecteur de fichiers. Nous n’accédons à aucun fichier sans action directe de votre part."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप केवल उन ऑडियो/वीडियो फ़ाइलों तक पहुँचता है जिन्हें आप फ़ाइल पिकर से स्पष्ट रूप से चुनते हैं। आपकी सीधी कार्रवाई के बिना हम कोई फ़ाइल एक्सेस नहीं करते।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリは、ファイルピッカーで明示的に選択した音声/動画ファイルにのみアクセスします。あなたの操作なしにファイルへアクセスすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱은 파일 선택기를 통해 사용자가 명시적으로 선택한 오디오/비디오 파일에만 접근합니다. 사용자의 직접 동작 없이 파일에 접근하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app acessa apenas arquivos de áudio/vídeo que você seleciona explicitamente pelo seletor de arquivos. Não acessamos nenhum arquivo sem sua ação direta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用只访问你通过文件选择器明确选择的音频/视频文件。没有你的直接操作，我们不会访问任何文件。"
          }
        }
      }
    },
