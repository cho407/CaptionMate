    "CaptionMate does not collect, store, or transmit any personal data. All processing is done locally on your device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptionMate erfasst, speichert oder überträgt keine personenbezogenen Daten. Die gesamte Verarbeitung erfolgt lokal auf deinem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptionMate does not collect, store, or transmit any personal data. All processing is done locally on your device."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptionMate does not collect, store, or transmit any personal data. All processing is done locally on your device."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يجمع CaptionMate أي بيانات شخصية أو يخزنها أو يرسلها. تتم كل المعالجة محليًا على جهازك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptionMate no recopila, almacena ni transmite datos personales. Todo el procesamiento se realiza localmente en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptionMate ne collecte, ne stocke ni ne transmet aucune donnée personnelle. Tout le traitement est effectué localement sur votre appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptionMate कोई व्यक्तिगत डेटा एकत्र, संग्रहीत या प्रसारित नहीं करता। सारी प्रोसेसिंग आपके डिवाइस पर स्थानीय रूप से होती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptionMateは個人データを収集、保存、送信しません。すべての処理はデバイス上でローカルに行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptionMate는 개인 데이터를 수집, 저장, 전송하지 않습니다. 모든 처리는 기기 안에서 로컬로 수행됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O CaptionMate não coleta, armazena nem transmite dados pessoais. Todo o processamento é feito localmente no seu dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptionMate 不会收集、存储或传输任何个人数据。所有处理都在你的设备本地完成。"
          }
        }
      }
    },
    "CaptionMate uses WhisperKit for speech recognition, which processes all data locally on your device. No data is sent to external servers for transcription." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptionMate verwendet WhisperKit für Spracherkennung und verarbeitet alle Daten lokal auf deinem Gerät. Für die Transkription werden keine Daten an externe Server gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptionMate uses WhisperKit for speech recognition, which processes all data locally on your device. No data is sent to external servers for transcription."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptionMate uses WhisperKit for speech recognition, which processes all data locally on your device. No data is sent to external servers for transcription."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم CaptionMate ‏WhisperKit للتعرف على الكلام، ويعالج كل البيانات محليًا على جهازك. لا تُرسل أي بيانات إلى خوادم خارجية للتفريغ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptionMate usa WhisperKit para el reconocimiento de voz y procesa todos los datos localmente en tu dispositivo. No se envían datos a servidores externos para la transcripción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptionMate utilise WhisperKit pour la reconnaissance vocale, avec un traitement local sur votre appareil. Aucune donnée n’est envoyée à des serveurs externes pour la transcription."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptionMate भाषण पहचान के लिए WhisperKit का उपयोग करता है, जो सारा डेटा आपके डिवाइस पर स्थानीय रूप से संसाधित करता है। ट्रांसक्रिप्शन के लिए कोई डेटा बाहरी सर्वर पर नहीं भेजा जाता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptionMateは音声認識にWhisperKitを使用し、すべてのデータをデバイス上でローカル処理します。文字起こしのために外部サーバーへデータを送信することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptionMate는 음성 인식에 WhisperKit을 사용하며 모든 데이터는 기기에서 로컬로 처리됩니다. 전사를 위해 외부 서버로 데이터가 전송되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O CaptionMate usa o WhisperKit para reconhecimento de fala, processando todos os dados localmente no seu dispositivo. Nenhum dado é enviado a servidores externos para transcrição."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptionMate 使用 WhisperKit 进行语音识别，所有数据都在你的设备本地处理。转录不会把数据发送到外部服务器。"
          }
        }
      }
    },
