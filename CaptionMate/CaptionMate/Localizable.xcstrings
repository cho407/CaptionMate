    "Network connectivity is used solely for downloading AI models from Hugging Face. No user data or usage analytics are transmitted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Netzwerkverbindung wird ausschließlich zum Herunterladen von KI-Modellen von Hugging Face verwendet. Es werden keine Nutzerdaten oder Analysen übertragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Network connectivity is used solely for downloading AI models from Hugging Face. No user data or usage analytics are transmitted."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Network connectivity is used solely for downloading AI models from Hugging Face. No user data or usage analytics are transmitted."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم الاتصال بالشبكة فقط لتنزيل نماذج الذكاء الاصطناعي من Hugging Face. لا تُرسل بيانات المستخدم أو تحليلات الاستخدام."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión de red solo se usa para descargar modelos de IA desde Hugging Face. No se transmiten datos de usuario ni analíticas de uso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion réseau sert uniquement à télécharger des modèles d’IA depuis Hugging Face. Aucune donnée utilisateur ni analyse d’utilisation n’est transmise."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्क कनेक्टिविटी केवल Hugging Face से AI मॉडल डाउनलोड करने के लिए उपयोग होती है। उपयोगकर्ता डेटा या उपयोग विश्लेषण प्रसारित नहीं होते।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク接続はHugging FaceからAIモデルをダウンロードする目的にのみ使用されます。ユーザーデータや利用分析は送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크 연결은 Hugging Face에서 AI 모델을 다운로드할 때만 사용됩니다. 사용자 데이터나 사용 분석은 전송되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão de rede é usada apenas para baixar modelos de IA do Hugging Face. Nenhum dado do usuário ou análise de uso é transmitido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网络连接仅用于从 Hugging Face 下载 AI 模型。不会传输用户数据或使用分析。"
          }
        }
      }
    },
