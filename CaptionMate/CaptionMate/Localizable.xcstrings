    "info.cache_prefill" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füllt den Cache mit vorherigem Kontext vor, um lange Dateien konsistenter zu verarbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When Cache Prefill is on, the decoder will try to use a lookup table of pre-computed KV caches instead of computing them during the decoding loop, which can speed up inference."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When Cache Prefill is on, the decoder will try to use a lookup table of pre-computed KV caches instead of computing them during the decoding loop, which can speed up inference."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تشغيل تعبئة ذاكرة التخزين المؤقت مسبقًا، سيحاول مفكك الترميز استخدام جدول بحث لذاكرات KV المحسوبة مسبقًا بدلًا من حسابها أثناء حلقة فك الترميز، مما قد يسرّع الاستدلال."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda contexto en caché para acelerar el procesamiento repetido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préremplit le cache avec le contexte précédent pour améliorer la cohérence des longs fichiers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गति बढ़ाने के लिए पिछले डिकोड कैश का उपयोग करता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前のコンテキストをキャッシュして、繰り返し処理を高速化します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캐시 미리 채우기가 활성화되면 디코더는 디코딩 루프 중에 계산하는 대신 미리 계산된 KV 캐시의 조회 테이블을 사용하려고 시도하여 추론 속도를 높일 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pré-carrega o cache com contexto anterior para melhorar a consistência em arquivos longos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用上一轮解码缓存来提升速度。"
          }
        }
      }
    },
    "info.chunking_strategy" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählt aus, wie lange Audiodateien in Abschnitte aufgeteilt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select the strategy to use for chunking audio data. If VAD is selected, the audio will be chunked based on voice activity (split on silent portions)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select the strategy to use for chunking audio data. If VAD is selected, the audio will be chunked based on voice activity (split on silent portions)."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر استراتيجية تقسيم بيانات الصوت. عند اختيار VAD، سيُقسّم الصوت بناءً على نشاط الصوت (الفصل عند المقاطع الصامتة)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cómo dividir audios largos. VAD utiliza pausas de silencio."
          }
        },
