    "info.word_timestamps" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzeugt Wort-Zeitstempel, wenn verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toggling this will enable/disable word-level timestamps in the transcription output.\nWhen enabled, each transcription segment is split into individual words with precise start and end times calculated using dynamic alignment.\nDisabling this option will result in only segment-level timestamps."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toggling this will enable/disable word-level timestamps in the transcription output.\nWhen enabled, each transcription segment is split into individual words with precise start and end times calculated using dynamic alignment.\nDisabling this option will result in only segment-level timestamps."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا الخيار إلى تفعيل/تعطيل الطوابع الزمنية على مستوى الكلمات في مخرجات التفريغ.\nعند التفعيل، يُقسّم كل مقطع تفريغ إلى كلمات منفردة مع أوقات بداية ونهاية دقيقة محسوبة باستخدام المحاذاة الديناميكية.\nإيقاف هذا الخيار سيؤدي إلى استخدام طوابع زمنية على مستوى المقاطع فقط."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera marcas de tiempo por palabra. Puede aumentar el tiempo de procesamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Génère les horodatages par mot si disponibles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्द-स्तर टाइमस्टैम्प बनाता है, जिससे प्रक्रिया धीमी हो सकती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語ごとのタイムスタンプを生成します。処理時間が増える場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정을 활성화하면 전사 출력에서 단어 단위 타임스탬프가 활성화/비활성화됩니다.\n활성화하면 각 전사 세그먼트가 개별 단어로 분할되며 동적 정렬을 사용하여 정확한 시작 및 종료 시간이 계산됩니다.\n이 옵션을 비활성화하면 세그먼트 단위 타임스탬프만 생성됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gera timestamps por palavra quando disponíveis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成单词级时间戳，处理会更慢。"
          }
        }
      }
    },
